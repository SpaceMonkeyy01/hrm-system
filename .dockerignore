# Never ship secrets or real HR data in the image.
.env
.env.*
!.env.example
database/*.sqlite
database/*.sqlite-*
storage/app/private/*
storage/app/public/*
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/inertia-devtools

# Rebuilt inside the image.
node_modules
vendor
public/build
public/hot
public/storage
bootstrap/cache/*.php

# Not needed to run.
.git
.github
.idea
.vscode
tests
phpunit*.xml
.phpunit.result.cache
# docs/ARCHITECTURE.md ships: Settings > System architecture renders it. The rest of docs/ stays out.
docs/*
!docs/ARCHITECTURE.md
*.log
composer.offline.*
